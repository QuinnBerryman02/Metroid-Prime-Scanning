# --- server ---
PORT=3000
HOST=0.0.0.0
INFERENCE_URL=http://127.0.0.1:8000
# comma separated list of allowed origins for CORS / WS
ALLOWED_ORIGINS=*

# --- inference ---
# Ultralytics/OpenVINO device: xpu (Intel iGPU) | npu | intel:cpu | cpu
OV_DEVICE=xpu
MODEL_PATH=./yolo11n.pt
EXPORT_OPENVINO=1
IMGSZ=640
CONF=0.25

# Stage B (lifting): segmentation + depth
SEGMENT=1
DEPTH=1
# segmenter: "sam2" (best masks, CPU ~2.4s) or "yolo11" (fast, OpenVINO iGPU ~0.05s)
SEGMENTER=sam2
SAM_MODEL=./notebooks/sam2.1_t.pt
SAM_DEVICE=cpu
YOLO_SEG_MODEL=./yolo11n-seg.pt
# Depth Anything V2, exported to OpenVINO on first run
DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
DEPTH_DEVICE=GPU
DEPTH_IR=./depth_anything_v2_small_openvino_model/depth_anything_v2_small.xml
# Horizontal FOV (deg) used to build intrinsics when the request omits one
FOV_DEG=60

# --- client (Vite, prefixed with VITE_) ---
VITE_SERVER_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
